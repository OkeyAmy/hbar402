# --- Hedera testnet ---
HEDERA_NETWORK=hedera:testnet

# Operator account. Issues the credits token and appends HCS receipts.
# Get one at https://portal.hedera.com/ — either key type works.
# ED25519 keys are DER-encoded ("302e0201..."), ECDSA keys are raw hex.
HEDERA_ACCOUNT_ID=
HEDERA_PRIVATE_KEY=

# Where x402 payments land.
#
# Must NOT be the credits token treasury. Hedera exempts a token's treasury from
# that token's own custom fees, so paying into the treasury silently disables the
# shareholder split. Run `pnpm account:revenue` to create a suitable account.
PAY_TO_ACCOUNT=
HBAR402_REVENUE_ACCOUNT_ID=
HBAR402_REVENUE_PRIVATE_KEY=

# --- x402 ---
# Must advertise hedera:testnet in its /supported response. Note that
# facilitator.x402.rs does NOT — it has no Hedera entry at all.
FACILITATOR_URL=https://x402.org/facilitator

# --- HCS consensus receipt log ---
# Create with `pnpm hcs:topic`. Public to read; submit key is the operator key.
HCS_RECEIPT_TOPIC_ID=

# --- assets ---
# HBAR is asset 0.0.0 with amounts in tinybars (1 HBAR = 1e8 tinybars).
HEDERA_USDC_TOKEN_ID=0.0.429274

# Credits token with fractional custom fees. Create with `pnpm hts:credits`,
# which also creates the shareholder accounts that collect the split.
HBAR402_CREDITS_TOKEN_ID=
HBAR402_CREDITS_DECIMALS=6
HBAR402_SHAREHOLDER_A=
HBAR402_SHAREHOLDER_A_KEY=
HBAR402_SHAREHOLDER_B=
HBAR402_SHAREHOLDER_B_KEY=

# --- mirror node (free, no key) ---
HEDERA_MIRROR_URL=https://testnet.mirrornode.hedera.com

# --- demo buyer, used by `pnpm buy`, `pnpm spike` and `pnpm customer` ---
# Must be a different account from PAY_TO_ACCOUNT: the facilitator requires the
# net credit to payTo to equal the price exactly, and if payer == payTo the net
# is zero and verification fails.
DEMO_BUYER_ACCOUNT_ID=
DEMO_BUYER_PRIVATE_KEY=

# --- optional: public base URL for absolute resource URLs in 402 responses ---
NEXT_PUBLIC_BASE_URL=
